{
  "name": "effectory",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "ultracite check .",
    "fix": "ultracite fix .",
    "test": "bun test",
    "verify": "bun run typecheck && bun run check && bun run test",
    "prepare": "effect-tsgo patch"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.5",
    "@effect/sql-sqlite-bun": "4.0.5",
    "@effectory/flow": "workspace:*",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@effect/tsgo": "0.56.0",
    "@types/bun": "1.4.3",
    "@types/node": "24.10.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "7.0.2",
    "ultracite": "8.0.1"
  },
  "overrides": {
    "effect": "4.0.5"
  },
  "engines": {
    "bun": ">=1.4.3",
    "node": ">=24.11.1"
  },
  "packageManager": "bun@1.4.3"
}

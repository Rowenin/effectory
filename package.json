{
  "name": "effectory",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rowenin/effectory.git"
  },
  "workspaces": [
    "packages/*",
    "extensions/*"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "effect-tsgo tsrs --noEmit",
    "check": "oxfmt --check . && bun run lint",
    "lint": "effect-tsgo --tsrs-lint oxlint --type-aware --deny-warnings",
    "fix": "oxfmt . && effect-tsgo --tsrs-lint oxlint --type-aware --fix",
    "test": "bun test",
    "verify": "bun run typecheck && bun run check && bun run test",
    "prepare": "effect-tsgo patch && git config core.hooksPath .githooks",
    "effectory": "bun packages/cli/src/main.ts",
    "build:binary": "bun scripts/build-binary.ts",
    "build:sdk": "bun scripts/build-sdk.ts",
    "release:assets": "bun scripts/release-assets.ts",
    "build:extension:aws-vault": "bun scripts/build-aws-vault-extension.ts",
    "generate:host-modules": "bun scripts/generate-host-modules.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.2",
    "@effect/sql-sqlite-bun": "4.1.2",
    "@offtree/effectory-sdk": "workspace:*",
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.5",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "typescript": "7.0.2",
    "ultracite": "8.1.1"
  },
  "overrides": {
    "effect": "4.1.2"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=24.11.1"
  },
  "packageManager": "bun@1.4.4"
}

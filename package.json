{
  "name": "effectory",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rowenin/effectory.git"
  },
  "workspaces": [
    "packages/*",
    "extensions/*"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "ultracite check .",
    "fix": "ultracite fix .",
    "test": "bun test",
    "verify": "bun run typecheck && bun run check && bun run test",
    "prepare": "effect-tsgo patch && git config core.hooksPath .githooks",
    "effectory": "bun packages/cli/src/main.ts",
    "build:binary": "bun scripts/build-binary.ts",
    "build:sdk": "bun scripts/build-sdk.ts",
    "release:assets": "bun scripts/release-assets.ts",
    "build:extension:aws-vault": "bun scripts/build-aws-vault-extension.ts",
    "generate:host-modules": "bun scripts/generate-host-modules.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.5",
    "@effect/sql-sqlite-bun": "4.0.5",
    "@offtree/effectory-sdk": "workspace:*",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@effect/tsgo": "0.56.0",
    "@types/bun": "1.4.3",
    "@types/node": "24.10.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "7.0.2",
    "ultracite": "8.0.1"
  },
  "overrides": {
    "effect": "4.0.5"
  },
  "engines": {
    "bun": ">=1.4.3",
    "node": ">=24.11.1"
  },
  "packageManager": "bun@1.4.3"
}

{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "effect/cli",
          "effect/http",
          "effect/Graph",
          "effect/sql",
          "@effect/sql-sqlite-bun",
          "effect/FileSystem",
          "effect/Path",
          "effect/Crypto",
          "effect/process",
          "effect/PlatformError",
          "@effect/platform-bun",
          "effect/rpc",
          "effect/workflow",
          "effect/cluster"
        ]
      }
    ]
  },
  "include": [
    "*.config.ts",
    "*.ts",
    "flows/**/*.ts",
    "examples/**/*.ts",
    "extensions/**/*.ts",
    "packages/**/*.ts",
    "scripts/**/*.ts"
  ]
}

{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "effectory",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "packages/core/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/cli/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/platform-bun/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/runtime/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "extensions/aws-vault/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "extensions/aws-vault/package.json",
          "jsonpath": "$.peerDependencies['@offtree/effectory-sdk']"
        },
        {
          "type": "generic",
          "path": "extensions/aws-vault/src/contracts.ts"
        },
        {
          "type": "json",
          "path": "extensions/agent-runner/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "extensions/agent-runner/package.json",
          "jsonpath": "$.peerDependencies['@offtree/effectory-sdk']"
        },
        {
          "type": "generic",
          "path": "extensions/agent-runner/src/contracts.ts"
        }
      ]
    }
  }
}
